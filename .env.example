# Resend API Key for sending transactional email notifications
RESEND_API_KEY="re_your_api_key_here"

# Notification recipient and sender
NOTIFICATION_EMAIL_TO="50gezichten@gmail.com"
NOTIFICATION_EMAIL_FROM="50 Gezichten <onboarding@resend.dev>"

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Required server-side for admin & service role actions
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# NextAuth / Auth.js Configuration for /admin GitHub OAuth
AUTH_SECRET="generate-a-secure-random-32-byte-secret"
AUTH_GITHUB_ID="your-github-oauth-client-id"
AUTH_GITHUB_SECRET="your-github-oauth-client-secret"

# GitHub Admin Allowlist (comma-separated list of GitHub user IDs or usernames)
ADMIN_GITHUB_IDS="your-numeric-github-user-id"
